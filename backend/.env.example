# Environment
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/mta_analytics?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# MTA Server Authentication (supports serverId:apiKey format)
MTA_API_KEYS=garage-main:mta-server-key-1,mta-server-key-2
MTA_SECRET=your-super-secret-hmac-key-change-this

# Auth & Security
ALLOW_PUBLIC_REGISTRATION=false
TRUST_PROXY=false

# Data Retention
EVENT_RETENTION_DAYS=14

# Frontend
FRONTEND_URL=http://localhost:5173

# CORS
CORS_ORIGIN=http://localhost:5173
